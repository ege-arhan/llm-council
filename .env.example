# Copy to .env and fill in a 9Router API key. Never commit .env.
LLM_API_BASE_URL=http://127.0.0.1:20128/v1
LLM_API_KEY=replace-with-your-9router-api-key
NINEROUTER_BASE_URL=http://127.0.0.1:20128
COUNCIL_COMBO=llm-council
# Optional: choose a specific chairman. Empty uses the combo's first member.
COUNCIL_CHAIRMAN_MODEL=
COUNCIL_DATA_DIR=data/conversations
